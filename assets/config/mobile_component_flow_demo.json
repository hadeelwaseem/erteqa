{
  "schemaVersion": "1.0",
  "app": {
    "name": "SOOQ Merchant Flow Demo",
    "bundleId": "com.sooq.merchant.flow.demo"
  },
  "theme": {
    "mode": "light",
    "colors": {
      "primary": "#1D4ED8",
      "surface": "#F8FAFC",
      "background": "#FFFFFF",
      "text": "#0F172A",
      "muted": "#64748B",
      "success": "#16A34A",
      "warning": "#D97706",
      "error": "#DC2626"
