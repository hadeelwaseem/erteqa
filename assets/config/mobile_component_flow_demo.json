      {
        "id": "tab-products",
        "label": "Products",
        "icon": "grid_view",
        "route": "/products"
      },
      {
        "id": "tab-checkout",
        "label": "Checkout",
        "icon": "shopping_cart",
        "route": "/checkout"
      }
    ]
  },
