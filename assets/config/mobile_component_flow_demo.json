        "id": "home-appbar",
        "type": "appBar",
        "props": {
          "title": "SOOQ Merchant"
        },
        "style": {
          "background": "#FFFFFF"
        }
      },
      "body": [
        {
          "id": "hero-card",
          "type": "container",
          "props": {},
