{
  "schemaVersion": "1.0",
  "app": {
    "name": "Puck Mobile Catalog",
    "bundleId": "com.puck.mobile.catalog"
  },
  "theme": {
    "mode": "light",
    "colors": {
      "primary": "#2563eb",
      "surface": "#f8fafc",
      "background": "#ffffff",
      "text": "#0f172a",
      "muted": "#64748b",
      "success": "#16a34a",
      "warning": "#d97706",
      "error": "#dc2626"
    },
    "typography": {
      "fontFamily": "system",
      "scale": {
        "xs": 12,
        "sm": 14,
        "md": 16,
        "lg": 18,
        "xl": 20,
        "xxl": 24,
        "display": 32
      },
      "weights": {
        "normal": 400,
        "medium": 500,
        "bold": 700
      },
      "lineHeight": {
        "tight": 1.25,
        "normal": 1.5,
        "relaxed": 1.75
      }
    },
    "radius": {
      "none": 0,
      "sm": 4,
      "md": 8,
      "lg": 12,
      "xl": 16,
      "full": 9999
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32
    },
    "buttons": {
      "sm": {
        "height": 32,
        "padX": 12,
        "fontSize": 14,
        "radius": 8
      },
      "md": {
        "height": 44,
        "padX": 16,
        "fontSize": 16,
        "radius": 10
      },
      "lg": {
        "height": 52,
        "padX": 24,
        "fontSize": 16,
        "radius": 12
      }
    }
  },
  "navigation": {
    "type": "tabs",
    "initialRoute": "/",
    "tabs": [
      {
        "id": "tab-1",
        "label": "Config 1",
        "icon": "home",
        "route": "/"
      },
      {
        "id": "tab-2",
        "label": "Config 2",
        "icon": "list",
        "route": "/config/2"
      },
      {
        "id": "tab-3",
        "label": "Config 3",
        "icon": "grid_view",
        "route": "/config/3"
      },
      {
        "id": "tab-4",
        "label": "Config 4",
        "icon": "settings",
        "route": "/config/4"
      }
    ]
  },
